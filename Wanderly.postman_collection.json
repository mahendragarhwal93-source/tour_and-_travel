{
  "info": { "name": "Wanderly Travel API", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json" },
  "variable": [
    { "key": "base", "value": "http://localhost:5000/api" },
    { "key": "token", "value": "" },
    { "key": "adminToken", "value": "" }
  ],
  "item": [
    { "name": "Auth", "item": [
      { "name": "Register", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "url": "{{base}}/auth/register", "body": { "mode": "raw", "raw": "{\"name\":\"Test User\",\"email\":\"test@example.com\",\"password\":\"secret1\"}" } } },
      { "name": "Login (demo user)", "event": [{"listen":"test","script":{"exec":["pm.collectionVariables.set('token', pm.response.json().token);"]}}], "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "url": "{{base}}/auth/login", "body": { "mode": "raw", "raw": "{\"email\":\"demo@travel.com\",\"password\":\"demo123\"}" } } },
      { "name": "Login (admin)", "event": [{"listen":"test","script":{"exec":["pm.collectionVariables.set('adminToken', pm.response.json().token);"]}}], "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "url": "{{base}}/auth/login", "body": { "mode": "raw", "raw": "{\"email\":\"admin@travel.com\",\"password\":\"admin123\"}" } } },
      { "name": "Me", "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{token}}"}], "url": "{{base}}/auth/me" } }
    ]},
    { "name": "Destinations", "item": [
      { "name": "List all", "request": { "method": "GET", "url": "{{base}}/destinations" } },
      { "name": "Search + filter + sort", "request": { "method": "GET", "url": "{{base}}/destinations?search=beach&category=Beach&maxPrice=8000&sort=price_asc" } },
      { "name": "Get one", "request": { "method": "GET", "url": "{{base}}/destinations/1" } },
      { "name": "Create (admin)", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{adminToken}}"}], "url": "{{base}}/destinations", "body": { "mode": "raw", "raw": "{\"name\":\"Udaipur\",\"country\":\"India\",\"category\":\"Heritage\",\"description\":\"City of Lakes\",\"image\":\"https://example.com/udaipur.jpg\",\"price_per_day\":3200}" } } },
      { "name": "Update (admin)", "request": { "method": "PUT", "header": [{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{adminToken}}"}], "url": "{{base}}/destinations/1", "body": { "mode": "raw", "raw": "{\"price_per_day\":3600}" } } },
      { "name": "Delete (admin)", "request": { "method": "DELETE", "header": [{"key":"Authorization","value":"Bearer {{adminToken}}"}], "url": "{{base}}/destinations/17" } }
    ]},
    { "name": "Trips", "item": [
      { "name": "Create trip", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{token}}"}], "url": "{{base}}/trips", "body": { "mode": "raw", "raw": "{\"title\":\"Summer Holiday\",\"start_date\":\"2027-05-01\",\"end_date\":\"2027-05-08\"}" } } },
      { "name": "My trips", "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{token}}"}], "url": "{{base}}/trips" } },
      { "name": "Add destination to trip", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{token}}"}], "url": "{{base}}/trips/1/destinations", "body": { "mode": "raw", "raw": "{\"destination_id\":1,\"days\":3}" } } },
      { "name": "Update days", "request": { "method": "PUT", "header": [{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{token}}"}], "url": "{{base}}/trips/1/destinations/1", "body": { "mode": "raw", "raw": "{\"days\":5}" } } },
      { "name": "Remove destination", "request": { "method": "DELETE", "header": [{"key":"Authorization","value":"Bearer {{token}}"}], "url": "{{base}}/trips/1/destinations/1" } },
      { "name": "Delete trip", "request": { "method": "DELETE", "header": [{"key":"Authorization","value":"Bearer {{token}}"}], "url": "{{base}}/trips/1" } }
    ]},
    { "name": "Bookings", "item": [
      { "name": "Book trip", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{token}}"}], "url": "{{base}}/bookings", "body": { "mode": "raw", "raw": "{\"trip_id\":1,\"travelers\":2,\"payment_method\":\"upi\"}" } } },
      { "name": "My bookings", "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{token}}"}], "url": "{{base}}/bookings" } },
      { "name": "Cancel booking", "request": { "method": "PUT", "header": [{"key":"Authorization","value":"Bearer {{token}}"}], "url": "{{base}}/bookings/1/cancel" } },
      { "name": "Admin stats", "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{adminToken}}"}], "url": "{{base}}/bookings/admin/stats" } }
    ]}
  ]
}
